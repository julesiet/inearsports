; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="INES-game"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ControllerManager="*res://scripts/autoload/controller_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
SceneTransitionManager="*res://scripts/autoload/scene_transition_manager.gd"
SessionManager="*res://scripts/autoload/session_manager.gd"
MusicManager="*res://scripts/autoload/music_manager.gd"
ButtonHoverManager="*res://scripts/autoload/button_hover_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="INES-game"

